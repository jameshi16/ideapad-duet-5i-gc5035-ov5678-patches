+};
+
+static int ov5678_regulators_probe(struct ov5678 *ov5678)
+{
+	unsigned int i;
+
+	for (i = 0; i < OV5678_NUM_SUPPLIES; i++)
+		ov5678->supplies[i].supply = ov5678_supply_names[i];
+
+	return devm_regulator_bulk_get(ov5678->dev, OV5678_NUM_SUPPLIES,
+				       ov5678->supplies);
+}
+
+static int ov5678_gpio_probe(struct ov5678 *ov5678)
+{
+	ov5678->pwdn_gpio = devm_gpiod_get_optional(ov5678->dev, "powerdown",
+						    GPIOD_OUT_LOW);
+	if (IS_ERR(ov5678->pwdn_gpio))
+		return PTR_ERR(ov5678->pwdn_gpio);
+
+	ov5678->reset_gpio = devm_gpiod_get_optional(ov5678->dev, "reset",
+						     GPIOD_OUT_LOW);
+	if (IS_ERR(ov5678->reset_gpio))
+		return PTR_ERR(ov5678->reset_gpio);
+
+	return 0;
+}
+
+static int ov5678_probe(struct i2c_client *client)
+{
+	struct fwnode_handle *handle;
+	struct ov5678 *ov5678;
+	u32 input_clk = 0;
+	bool full_power;
+	int ret;
+
+	ov5678 = devm_kzalloc(&client->dev, sizeof(*ov5678), GFP_KERNEL);
+	if (!ov5678)
+		return -ENOMEM;
+
+	ov5678->dev = &client->dev;
+
+	ov5678->xvclk = devm_v4l2_sensor_clk_get(ov5678->dev, NULL);
+	if (IS_ERR(ov5678->xvclk))
+		return dev_err_probe(ov5678->dev, PTR_ERR(ov5678->xvclk),
+				     "error getting clock\n");
+
+	input_clk = clk_get_rate(ov5678->xvclk);
+	if (input_clk != OV5678_XVCLK_FREQ) {
+		dev_warn(ov5678->dev,
+			 "Unexpected clock frequency %u, expected %u\n",
+			 input_clk, OV5678_XVCLK_FREQ);
+	}
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&ov5678->sd, client, &ov5678_subdev_ops);
+	ov5678->sd.internal_ops = &ov5678_internal_ops;
+
+	ret = ov5678_regulators_probe(ov5678);
+	if (ret)
+		return dev_err_probe(ov5678->dev, ret, "Regulators probe failed\n");
+
+	ret = ov5678_gpio_probe(ov5678);
+	if (ret)
+		return dev_err_probe(ov5678->dev, ret, "GPIO probe failed\n");
+
+	/*
+	 * Graph Endpoint. If it's missing we defer rather than fail, as this
+	 * sensor is known to co-exist on systems with the IPU3 and so it might
+	 * be created by the ipu-bridge.
+	 */
+	handle = fwnode_graph_get_next_endpoint(dev_fwnode(ov5678->dev), NULL);
+	if (!handle)
+		return dev_err_probe(ov5678->dev, -EPROBE_DEFER,
+				     "Endpoint for node get failed\n");
+
+	ov5678->endpoint.bus_type = V4L2_MBUS_CSI2_DPHY;
+	ov5678->endpoint.bus.mipi_csi2.num_data_lanes = 2;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(handle, &ov5678->endpoint);
+	fwnode_handle_put(handle);
+	if (ret)
+		return dev_err_probe(ov5678->dev, ret, "Endpoint parse failed\n");
+
+	full_power = acpi_dev_state_d0(ov5678->dev);
+	if (full_power) {
+		ret = ov5678_runtime_resume(ov5678->dev);
+		if (ret) {
+			dev_err_probe(ov5678->dev, ret, "Power up failed\n");
+			goto error_endpoint;
+		}
+
+		/* Check module identity */
+		ret = ov5678_identify_module(ov5678);
+		if (ret) {
+			dev_err_probe(ov5678->dev, ret, "ov5678_identify_module() error\n");
+			goto error_power_off;
+		}
+	}
+
+	mutex_init(&ov5678->mutex);
+
+	/* Set default mode to max resolution */
+	ov5678->cur_mode = &supported_modes[0];
+
+	ret = ov5678_init_controls(ov5678);
+	if (ret) {
+		dev_err_probe(ov5678->dev, ret, "ov5678_init_controls() error\n");
+		goto error_mutex_destroy;
+	}
+
+	ov5678->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE |
+			    V4L2_SUBDEV_FL_HAS_EVENTS;
+	ov5678->sd.entity.ops = &ov5678_subdev_entity_ops;
+	ov5678->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	/* Source pad initialization */
+	ov5678->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&ov5678->sd.entity, 1, &ov5678->pad);
+	if (ret) {
+		dev_err_probe(ov5678->dev, ret, "media_entity_pads_init() error\n");
+		goto error_handler_free;
+	}
+
+	/* Set the device's state to active if it's in D0 state. */
+	if (full_power)
+		pm_runtime_set_active(ov5678->dev);
+	pm_runtime_enable(ov5678->dev);
+
+	/* Async register for subdev */
+	ret = v4l2_async_register_subdev_sensor(&ov5678->sd);
+	if (ret < 0) {
+		dev_err_probe(ov5678->dev, ret, "v4l2_async_register_subdev() error\n");
+		goto error_pm_disable;
+	}
+
+	pm_runtime_idle(ov5678->dev);
+
+	return 0;
+
+error_pm_disable:
+	pm_runtime_disable(ov5678->dev);
+
+	media_entity_cleanup(&ov5678->sd.entity);
+
+error_handler_free:
+	v4l2_ctrl_handler_free(ov5678->sd.ctrl_handler);
+
+error_mutex_destroy:
+	mutex_destroy(&ov5678->mutex);
+
+error_power_off:
+	if (full_power)
+		ov5678_runtime_suspend(ov5678->dev);
+
+error_endpoint:
+	v4l2_fwnode_endpoint_free(&ov5678->endpoint);
+
+	return ret;
+}
+
+static void ov5678_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov5678 *ov5678 = to_ov5678(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	mutex_destroy(&ov5678->mutex);
+
+	pm_runtime_disable(ov5678->dev);
+	ov5678_runtime_suspend(ov5678->dev);
+
+	v4l2_fwnode_endpoint_free(&ov5678->endpoint);
+}
