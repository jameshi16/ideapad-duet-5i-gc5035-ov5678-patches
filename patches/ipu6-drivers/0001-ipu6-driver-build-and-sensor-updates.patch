+static const struct ov5678_reg_list *ov5678_get_mode_reg_list(
+	struct ov5678 *ov5678)
+{
+	if (ov5678->chip_id == OV5678_CHIP_ID_ALT &&
+	    ov5678->cur_mode->width == 2592 &&
+	    ov5678->cur_mode->height == 1944)
+		return &mode_2592x1944_5675_reg_list;
+
+	return &ov5678->cur_mode->reg_list;
+}
