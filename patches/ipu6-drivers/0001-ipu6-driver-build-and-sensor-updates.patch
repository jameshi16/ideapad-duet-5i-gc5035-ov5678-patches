+static int ov5678_get_link_freq_index(struct ov5678 *ov5678,
+				      const struct ov5678_mode *mode)
+{
+	if (ov5678->chip_id == OV5678_CHIP_ID_ALT)
+		return OV5678_LINK_FREQ_450MHZ_INDEX;
+
+	return mode->link_freq_index;
+}
