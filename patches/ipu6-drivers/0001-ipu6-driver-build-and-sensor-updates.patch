+static void ov5678_log_gpio_state(struct ov5678 *ov5678, const char *tag)
+{
+	int pwdn = -ENODEV;
+	int reset = -ENODEV;
+
+	if (ov5678->pwdn_gpio)
+		pwdn = gpiod_get_value_cansleep(ov5678->pwdn_gpio);
+	if (ov5678->reset_gpio)
+		reset = gpiod_get_value_cansleep(ov5678->reset_gpio);
+
+	dev_info(ov5678->dev, "%s gpio state: powerdown=%d reset=%d\n",
+		 tag, pwdn, reset);
+}
