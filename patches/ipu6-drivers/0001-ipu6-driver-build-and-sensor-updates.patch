+static void ov5678_log_reg8(struct ov5678 *ov5678, u16 reg, const char *name)
+{
+	u32 val;
+	int ret;
+
+	ret = ov5678_read_reg(ov5678, reg, OV5678_REG_VALUE_08BIT, &val);
+	if (ret)
+		dev_info(ov5678->dev, "%s read reg 0x%04x failed: %d\n", name,
+			 reg, ret);
+	else
+		dev_info(ov5678->dev, "%s reg 0x%04x = 0x%02x\n", name, reg,
+			 val & 0xff);
+}
+
+/* Read registers up to 4 at a time */
+static int ov5678_read_reg(struct ov5678 *ov5678, u16 reg, unsigned int len,
+			   u32 *val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&ov5678->sd);
+	struct i2c_msg msgs[2];
+	u8 *data_be_p;
+	__be32 data_be = 0;
+	__be16 reg_addr_be = cpu_to_be16(reg);
+	int ret;
+
+	if (len > 4)
+		return -EINVAL;
+
+	data_be_p = (u8 *)&data_be;
+	/* Write register address */
+	msgs[0].addr = client->addr;
+	msgs[0].flags = 0;
+	msgs[0].len = 2;
+	msgs[0].buf = (u8 *)&reg_addr_be;
+
+	/* Read data from register */
+	msgs[1].addr = client->addr;
+	msgs[1].flags = I2C_M_RD;
+	msgs[1].len = len;
+	msgs[1].buf = &data_be_p[4 - len];
+
+	ret = i2c_transfer(client->adapter, msgs, ARRAY_SIZE(msgs));
+	if (ret != ARRAY_SIZE(msgs))
+		return -EIO;
+
+	*val = be32_to_cpu(data_be);
+
+	return 0;
+}
+
+/* Write registers up to 4 at a time */
+static int ov5678_write_reg(struct ov5678 *ov5678, u16 reg, unsigned int len,
+			    u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&ov5678->sd);
+	int buf_i;
+	int val_i;
+	u8 buf[6];
+	u8 *val_p;
+	__be32 tmp;
+
+	if (len > 4)
+		return -EINVAL;
+
+	buf[0] = reg >> 8;
+	buf[1] = reg & 0xff;
+
+	tmp = cpu_to_be32(val);
+	val_p = (u8 *)&tmp;
+	buf_i = 2;
+	val_i = 4 - len;
+
+	while (val_i < 4)
+		buf[buf_i++] = val_p[val_i++];
+
+	if (i2c_master_send(client, buf, len + 2) != len + 2)
+		return -EIO;
+
+	return 0;
+}
+
+/* Write a list of registers */
+static int ov5678_write_regs(struct ov5678 *ov5678,
+			     const struct ov5678_reg *regs, unsigned int len)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < len; i++) {
+		ret = ov5678_write_reg(ov5678, regs[i].address, 1, regs[i].val);
+		if (ret) {
+			dev_err_ratelimited(
+				ov5678->dev,
+				"Failed to write reg 0x%4.4x. error = %d\n",
+				regs[i].address, ret);
+
+			return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int ov5678_write_reg_list(struct ov5678 *ov5678,
+				 const struct ov5678_reg_list *r_list)
+{
+	return ov5678_write_regs(ov5678, r_list->regs, r_list->num_of_regs);
+}
+
+static int ov5678_update_digital_gain(struct ov5678 *ov5678, u32 d_gain)
+{
+	int ret;
+
+	ret = ov5678_write_reg(ov5678, OV5678_REG_R_DGTL_GAIN,
+			       OV5678_REG_VALUE_16BIT, d_gain);
+	if (ret)
+		return ret;
+
+	ret = ov5678_write_reg(ov5678, OV5678_REG_G_DGTL_GAIN,
+			       OV5678_REG_VALUE_16BIT, d_gain);
+	if (ret)
+		return ret;
+
+	return ov5678_write_reg(ov5678, OV5678_REG_B_DGTL_GAIN,
+				OV5678_REG_VALUE_16BIT, d_gain);
+}
+
+static int ov5678_enable_test_pattern(struct ov5678 *ov5678, u32 pattern)
+{
+	u32 val;
+	int ret;
+
+	/* Set the bayer order that we support */
+	ret = ov5678_write_reg(ov5678, OV5678_REG_TEST_PATTERN_CTRL,
+			       OV5678_REG_VALUE_08BIT, 0);
+	if (ret)
+		return ret;
+
+	ret = ov5678_read_reg(ov5678, OV5678_REG_TEST_PATTERN,
+			      OV5678_REG_VALUE_08BIT, &val);
+	if (ret)
+		return ret;
+
+	if (pattern)
+		val |= OV5678_TEST_PATTERN_ENABLE;
+	else
+		val &= ~OV5678_TEST_PATTERN_ENABLE;
+
+	return ov5678_write_reg(ov5678, OV5678_REG_TEST_PATTERN,
+				OV5678_REG_VALUE_08BIT, val);
+}
+
+/* Initialize control handlers */
+static int ov5678_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ov5678 *ov5678 = container_of(ctrl->handler,
+					     struct ov5678, ctrl_handler);
+	s64 max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		max = ov5678->cur_mode->height + ctrl->val - 8;
+		__v4l2_ctrl_modify_range(ov5678->exposure,
+					 ov5678->exposure->minimum, max,
+					 ov5678->exposure->step, max);
+		break;
+	}
+
+	/* V4L2 controls values will be applied only when power is already up */
+	if (!pm_runtime_get_if_in_use(ov5678->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = ov5678_write_reg(ov5678, OV5678_REG_ANALOG_GAIN,
+				       OV5678_REG_VALUE_16BIT, ctrl->val);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		ret = ov5678_update_digital_gain(ov5678, ctrl->val);
+		break;
+	case V4L2_CID_EXPOSURE:
+		/* 4 least significant bits of expsoure are fractional part */
+		ret = ov5678_write_reg(ov5678, OV5678_REG_EXPOSURE,
+				       OV5678_REG_VALUE_24BIT, ctrl->val << 4);
+		break;
+	case V4L2_CID_VBLANK:
+		/* Update VTS that meets expected vertical blanking */
+		ret = ov5678_write_reg(ov5678, OV5678_REG_VTS,
+				       OV5678_REG_VALUE_16BIT,
+				       ov5678->cur_mode->height + ctrl->val);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = ov5678_enable_test_pattern(ov5678, ctrl->val);
+		break;
+	case V4L2_CID_HBLANK:
+	case V4L2_CID_LINK_FREQ:
+	case V4L2_CID_PIXEL_RATE:
+		ret = 0;
+		break;
+	default:
+		ret = -EINVAL;
+		dev_info(ov5678->dev, "%s Unhandled id:0x%x, val:0x%x\n",
+			 __func__, ctrl->id, ctrl->val);
+		break;
+	}
+
+	pm_runtime_put(ov5678->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops ov5678_ctrl_ops = {
+	.s_ctrl = ov5678_set_ctrl,
+};
+
+/* Initialize control handlers */
+static int ov5678_init_controls(struct ov5678 *ov5678)
+{
+	struct v4l2_mbus_config_mipi_csi2 *bus_mipi_csi2 =
+		&ov5678->endpoint.bus.mipi_csi2;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *ctrl_hdlr;
+	int link_freq_index;
+	unsigned int lanes_count;
+	s64 mipi_pixel_rate;
+	s64 vblank_max;
+	s64 vblank_def;
+	s64 vblank_min;
+	s64 exposure_max;
+	int ret;
+
+	ctrl_hdlr = &ov5678->ctrl_handler;
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 10);
+	if (ret)
+		return ret;
+
+	ctrl_hdlr->lock = &ov5678->mutex;
+	link_freq_index = ov5678_get_link_freq_index(ov5678, ov5678->cur_mode);
+	ov5678->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+						   &ov5678_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(link_freq_menu_items) - 1,
+						   link_freq_index,
+						   link_freq_menu_items);
+	if (ov5678->link_freq)
+		ov5678->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	/* By default, V4L2_CID_PIXEL_RATE is read only */
+	lanes_count = bus_mipi_csi2->num_data_lanes;
+	mipi_pixel_rate = link_freq_menu_items[link_freq_index] * 2 *
+			  lanes_count / 10;
+
+	ov5678->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &ov5678_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       mipi_pixel_rate,
+					       mipi_pixel_rate,
+					       1,
+					       mipi_pixel_rate);
+
+	vblank_max = OV5678_VTS_MAX - ov5678->cur_mode->height;
+	vblank_def = ov5678->cur_mode->vts_def - ov5678->cur_mode->height;
+	vblank_min = ov5678->cur_mode->vts_min - ov5678->cur_mode->height;
+	ov5678->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &ov5678_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank_min,
+					   vblank_max, 1, vblank_def);
+
+	ov5678->hblank = v4l2_ctrl_new_std(
+				ctrl_hdlr, &ov5678_ctrl_ops, V4L2_CID_HBLANK,
+				OV5678_FIXED_PPL - ov5678->cur_mode->width,
+				OV5678_FIXED_PPL - ov5678->cur_mode->width, 1,
+				OV5678_FIXED_PPL - ov5678->cur_mode->width);
+	if (ov5678->hblank)
+		ov5678->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	/* Get min, max, step, default from sensor */
+	v4l2_ctrl_new_std(ctrl_hdlr, &ov5678_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  ANALOG_GAIN_MIN, ANALOG_GAIN_MAX, ANALOG_GAIN_STEP,
+			  ANALOG_GAIN_DEFAULT);
+
+	/* Digital gain */
+	v4l2_ctrl_new_std(ctrl_hdlr, &ov5678_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  OV5678_DGTL_GAIN_MIN, OV5678_DGTL_GAIN_MAX,
+			  OV5678_DGTL_GAIN_STEP, OV5678_DGTL_GAIN_DEFAULT);
+
+	/* Get min, max, step, default from sensor */
+	exposure_max = ov5678->cur_mode->vts_def - 8;
+	ov5678->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &ov5678_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     OV5678_EXPOSURE_MIN,
+					     exposure_max, OV5678_EXPOSURE_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &ov5678_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(ov5678_test_pattern_menu) - 1,
+				     0, 0, ov5678_test_pattern_menu);
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(ov5678->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &ov5678_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error;
+
+	ov5678->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int ov5678_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt =
+				v4l2_subdev_state_get_format(state, 0);
+	const struct ov5678_mode *default_mode = &supported_modes[0];
+	struct v4l2_rect *crop = v4l2_subdev_state_get_crop(state, 0);
+
+	fmt->width = default_mode->width;
+	fmt->height = default_mode->height;
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(V4L2_COLORSPACE_SRGB);
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(V4L2_COLORSPACE_SRGB);
+
+	*crop = *default_mode->analog_crop;
+
+	return 0;
+}
+
+static int ov5678_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	/* Only one bayer order GRBG is supported */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+
+	return 0;
+}
+
+static int ov5678_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+
+	if (fse->code != MEDIA_BUS_FMT_SGRBG10_1X10)
+		return -EINVAL;
+
+	fse->min_width = supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static void ov5678_update_pad_format(const struct ov5678_mode *mode,
+				     struct v4l2_subdev_format *fmt)
+{
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->format.field = V4L2_FIELD_NONE;
+}
+
+static int ov5678_do_get_pad_format(struct ov5678 *ov5678,
+				    struct v4l2_subdev_state *sd_state,
+				    struct v4l2_subdev_format *fmt)
+{
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(sd_state,
+							    fmt->pad);
+	else
+		ov5678_update_pad_format(ov5678->cur_mode, fmt);
+
+	return 0;
+}
+
+static int ov5678_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct ov5678 *ov5678 = to_ov5678(sd);
+	int ret;
+
+	mutex_lock(&ov5678->mutex);
+	ret = ov5678_do_get_pad_format(ov5678, sd_state, fmt);
+	mutex_unlock(&ov5678->mutex);
+
+	return ret;
+}
+
+static int ov5678_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct ov5678 *ov5678 = to_ov5678(sd);
+	struct v4l2_mbus_config_mipi_csi2 *bus_mipi_csi2 =
+		&ov5678->endpoint.bus.mipi_csi2;
+	const struct ov5678_mode *mode;
+	int link_freq_index;
+	unsigned int lanes_count;
+	s64 mipi_pixel_rate;
+	s32 vblank_def;
+	s64 link_freq;
+	s32 h_blank;
+
+	mutex_lock(&ov5678->mutex);
+
+	fmt->format.code = MEDIA_BUS_FMT_SGRBG10_1X10;
+
+	mode = v4l2_find_nearest_size(supported_modes,
+				      ARRAY_SIZE(supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+	ov5678_update_pad_format(mode, fmt);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
+	} else {
+		ov5678->cur_mode = mode;
+		link_freq_index = ov5678_get_link_freq_index(ov5678, mode);
+		__v4l2_ctrl_s_ctrl(ov5678->link_freq, link_freq_index);
+
+		lanes_count = bus_mipi_csi2->num_data_lanes;
+		link_freq = link_freq_menu_items[link_freq_index];
+		/* pixel_rate = link_freq * 2 * nr_of_lanes / bits_per_sample */
+		mipi_pixel_rate = div_s64(link_freq * 2 * lanes_count, 10);
+		__v4l2_ctrl_s_ctrl_int64(
+			ov5678->pixel_rate,
+			mipi_pixel_rate);
+		/* Update limits and set FPS to default */
+		vblank_def = ov5678->cur_mode->vts_def -
+			     ov5678->cur_mode->height;
+		__v4l2_ctrl_modify_range(
+			ov5678->vblank,
+			ov5678->cur_mode->vts_min - ov5678->cur_mode->height,
+			OV5678_VTS_MAX - ov5678->cur_mode->height, 1,
+			vblank_def);
+		__v4l2_ctrl_s_ctrl(ov5678->vblank, vblank_def);
+		h_blank = OV5678_FIXED_PPL - ov5678->cur_mode->width;
+		__v4l2_ctrl_modify_range(ov5678->hblank, h_blank, h_blank, 1,
+					 h_blank);
+	}
+
+	mutex_unlock(&ov5678->mutex);
+
+	return 0;
+}
+
+static int ov5678_get_skip_frames(struct v4l2_subdev *sd, u32 *frames)
+{
+	*frames = OV5678_NUM_OF_SKIP_FRAMES;
+
+	return 0;
+}
+
+/* Verify chip ID */
+static int ov5678_identify_module(struct ov5678 *ov5678)
+{
+	int ret;
+	u32 val;
+
+	if (ov5678->identified)
+		return 0;
+
+	ret = ov5678_read_reg(ov5678, OV5678_REG_CHIP_ID,
+			      OV5678_REG_VALUE_24BIT, &val);
+	if (ret)
+		return ret;
+
+	if (val != OV5678_CHIP_ID && val != OV5678_CHIP_ID_ALT) {
+		dev_err(ov5678->dev,
+			"chip id mismatch: expected 0x%x/0x%x, got 0x%x\n",
+			OV5678_CHIP_ID, OV5678_CHIP_ID_ALT, val);
+		return -ENXIO;
+	}
+
+	if (val == OV5678_CHIP_ID_ALT)
+		dev_info(ov5678->dev, "detected alternate chip id 0x%x\n", val);
+
+	ov5678->chip_id = val;
+	ov5678->identified = true;
+
+	return 0;
+}
+
+static int ov5678_mipi_configure(struct ov5678 *ov5678)
+{
+	struct v4l2_mbus_config_mipi_csi2 *bus_mipi_csi2 =
+		&ov5678->endpoint.bus.mipi_csi2;
+	unsigned int lanes_count = bus_mipi_csi2->num_data_lanes;
+
+	return ov5678_write_reg(ov5678, OV5678_MIPI_SC_CTRL0_REG,
+				OV5678_REG_VALUE_08BIT,
+				OV5678_MIPI_SC_CTRL0_LANES(lanes_count) |
+				OV5678_MIPI_SC_CTRL0_MIPI_EN |
+				OV5678_MIPI_SC_CTRL0_RESERVED);
+}
+
+/* Prepare streaming by writing default values and customized values */
+static int ov5678_start_streaming(struct ov5678 *ov5678)
+{
+	struct v4l2_mbus_config_mipi_csi2 *bus_mipi_csi2 =
+		&ov5678->endpoint.bus.mipi_csi2;
+	const struct ov5678_reg_list *reg_list;
+	u32 val;
+	int link_freq_index;
+	int ret;
+
+	link_freq_index = ov5678_get_link_freq_index(ov5678, ov5678->cur_mode);
+
+	dev_info(ov5678->dev,
+		 "%s: begin mode=%ux%u lanes=%u link_freq=%lld identified=%d\n",
+		 __func__, ov5678->cur_mode->width, ov5678->cur_mode->height,
+		 bus_mipi_csi2->num_data_lanes,
+		 link_freq_menu_items[link_freq_index],
+		 ov5678->identified);
+	ov5678_log_gpio_state(ov5678, __func__);
+	ov5678_log_reg8(ov5678, OV5678_REG_MODE_SELECT, "pre-start");
+
+	ret = ov5678_identify_module(ov5678);
+	if (ret) {
+		dev_err(ov5678->dev, "%s identify failed: %d\n", __func__, ret);
+		return ret;
+	}
+
+	ret = ov5678_read_reg(ov5678, OV5678_REG_CHIP_ID,
+			      OV5678_REG_VALUE_24BIT, &val);
+	if (ret)
+		dev_info(ov5678->dev, "%s chip-id read failed: %d\n",
+			 __func__, ret);
+	else
+		dev_info(ov5678->dev, "%s chip-id now: 0x%06x\n", __func__, val);
+
+	/* Get out of from software reset */
+	ret = ov5678_write_reg(ov5678, OV5678_REG_SOFTWARE_RST,
+			       OV5678_REG_VALUE_08BIT, OV5678_SOFTWARE_RST);
+	if (ret) {
+		dev_err(ov5678->dev, "%s failed to set powerup registers\n",
+			__func__);
+		return ret;
+	}
+	ov5678_log_reg8(ov5678, OV5678_REG_SOFTWARE_RST, "post-sw-reset");
+	ov5678_log_reg8(ov5678, OV5678_REG_MODE_SELECT, "post-sw-reset");
+
+	/* Setup PLL */
+	link_freq_index = ov5678_get_link_freq_index(ov5678, ov5678->cur_mode);
+	reg_list = &link_freq_configs[link_freq_index].reg_list;
+	ret = ov5678_write_reg_list(ov5678, reg_list);
+	if (ret) {
+		dev_err(ov5678->dev, "%s failed to set plls\n", __func__);
+		return ret;
+	}
+	dev_info(ov5678->dev, "%s pll registers applied\n", __func__);
+
+	/* Apply default values of current mode */
+	reg_list = ov5678_get_mode_reg_list(ov5678);
+	ret = ov5678_write_reg_list(ov5678, reg_list);
+	if (ret) {
+		dev_err(ov5678->dev, "%s failed to set mode\n", __func__);
+		return ret;
+	}
+	dev_info(ov5678->dev, "%s mode registers applied\n", __func__);
+
+	if (ov5678->chip_id != OV5678_CHIP_ID_ALT) {
+		ret = ov5678_mipi_configure(ov5678);
+		if (ret) {
+			dev_err(ov5678->dev, "%s failed to configure MIPI\n",
+				__func__);
+			return ret;
+		}
+		ov5678_log_reg8(ov5678, OV5678_MIPI_SC_CTRL0_REG,
+				"post-mipi-config");
+	} else {
+		dev_info(ov5678->dev,
+			 "%s: skipping OV5678 MIPI_SC_CTRL0 write for 0x5675\n",
+			 __func__);
+	}
+
+	ret = __v4l2_ctrl_handler_setup(ov5678->sd.ctrl_handler);
+	if (ret) {
+		dev_err(ov5678->dev, "%s ctrl setup failed: %d\n", __func__, ret);
+		return ret;
+	}
+	dev_info(ov5678->dev, "%s controls applied\n", __func__);
+
+	/* Write stream on list */
+	ov5678_log_reg8(ov5678, OV5678_REG_MODE_SELECT, "pre-stream-on");
+	ret = ov5678_write_reg(ov5678, OV5678_REG_MODE_SELECT,
+			       OV5678_REG_VALUE_08BIT, OV5678_MODE_STREAMING);
+	if (ret) {
+		dev_err(ov5678->dev, "%s failed to set stream\n", __func__);
+		return ret;
+	}
+	ov5678_log_reg8(ov5678, OV5678_REG_MODE_SELECT, "post-stream-on");
+	ov5678_log_gpio_state(ov5678, "post-stream-on");
+	dev_info(ov5678->dev, "%s: done\n", __func__);
+
+	return 0;
+}
+
+static int ov5678_stop_streaming(struct ov5678 *ov5678)
+{
+	int ret;
+
+	ov5678_log_reg8(ov5678, OV5678_REG_MODE_SELECT, "pre-stream-off");
+
+	ret = ov5678_write_reg(ov5678, OV5678_REG_MODE_SELECT,
+			       OV5678_REG_VALUE_08BIT, OV5678_MODE_STANDBY);
+	if (ret)
+		dev_err(ov5678->dev, "%s failed to set stream\n", __func__);
+	ov5678_log_reg8(ov5678, OV5678_REG_MODE_SELECT, "post-stream-off");
+	ov5678_log_gpio_state(ov5678, "post-stream-off");
+
+	/* Return success even if it was an error, as there is nothing the
+	 * caller can do about it.
+	 */
+	return 0;
+}
+
+static int ov5678_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct ov5678 *ov5678 = to_ov5678(sd);
+	int ret = 0;
+
+	mutex_lock(&ov5678->mutex);
+	dev_info(ov5678->dev, "%s: enable=%d\n", __func__, enable);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(ov5678->dev);
+		if (ret < 0)
+			goto unlock_and_return;
+
+		ret = ov5678_start_streaming(ov5678);
+		if (ret)
+			goto error;
+		dev_info(ov5678->dev, "%s: stream-on path succeeded\n", __func__);
+	} else {
+		ret = ov5678_stop_streaming(ov5678);
+		pm_runtime_put(ov5678->dev);
+		dev_info(ov5678->dev, "%s: stream-off path done\n", __func__);
+	}
+	goto unlock_and_return;
+
+error:
+	dev_err(ov5678->dev, "%s: stream-on path failed: %d\n", __func__, ret);
+	pm_runtime_put(ov5678->dev);
+
+unlock_and_return:
+	mutex_unlock(&ov5678->mutex);
+
+	return ret;
+}
+
+static int __maybe_unused ov5678_runtime_resume(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov5678 *ov5678 = to_ov5678(sd);
+	unsigned long delay_us;
+	u32 chip_id;
+	int ret;
+
+	dev_info(ov5678->dev, "%s: begin\n", __func__);
+	ov5678_log_gpio_state(ov5678, "runtime-resume-entry");
+
+	ret = clk_prepare_enable(ov5678->xvclk);
+	if (ret)
+		return ret;
+
+	ret = regulator_bulk_enable(OV5678_NUM_SUPPLIES, ov5678->supplies);
+	if (ret) {
+		clk_disable_unprepare(ov5678->xvclk);
+		return ret;
+	}
+
+	if (ov5678->pwdn_gpio)
+		gpiod_set_value_cansleep(ov5678->pwdn_gpio, 0);
+	if (ov5678->reset_gpio)
+		gpiod_set_value_cansleep(ov5678->reset_gpio, 0);
+	ov5678_log_gpio_state(ov5678, "runtime-resume-after-gpio");
+
+	/* 8192 * 2 clock pulses before the first SCCB transaction. */
+	delay_us = DIV_ROUND_UP(8192 * 2 * 1000,
+				DIV_ROUND_UP(OV5678_XVCLK_FREQ, 1000));
+	fsleep(delay_us);
+
+	ret = ov5678_read_reg(ov5678, OV5678_REG_CHIP_ID,
+			      OV5678_REG_VALUE_24BIT, &chip_id);
+	if (ret)
+		dev_info(ov5678->dev, "%s: chip-id read failed: %d\n",
+			 __func__, ret);
+	else
+		dev_info(ov5678->dev, "%s: chip-id=0x%06x\n", __func__, chip_id);
+
+	ov5678_log_reg8(ov5678, OV5678_REG_MODE_SELECT, "runtime-resume-mode");
+	dev_info(ov5678->dev, "%s: done\n", __func__);
+
+	return 0;
+}
+
+static int __maybe_unused ov5678_runtime_suspend(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ov5678 *ov5678 = to_ov5678(sd);
+
+	if (ov5678->reset_gpio)
+		gpiod_set_value_cansleep(ov5678->reset_gpio, 1);
+	if (ov5678->pwdn_gpio)
+		gpiod_set_value_cansleep(ov5678->pwdn_gpio, 1);
+	regulator_bulk_disable(OV5678_NUM_SUPPLIES, ov5678->supplies);
+	clk_disable_unprepare(ov5678->xvclk);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_core_ops ov5678_core_ops = {
+	.log_status = v4l2_ctrl_subdev_log_status,
+	.subscribe_event = v4l2_ctrl_subdev_subscribe_event,
+	.unsubscribe_event = v4l2_event_subdev_unsubscribe,
+};
+
+static const struct v4l2_rect *
+__ov5678_get_pad_crop(struct ov5678 *sensor, struct v4l2_subdev_state *state,
+		      unsigned int pad, enum v4l2_subdev_format_whence which)
+{
+	const struct ov5678_mode *mode = sensor->cur_mode;
+
+	switch (which) {
+	case V4L2_SUBDEV_FORMAT_TRY:
+		return v4l2_subdev_state_get_crop(state, pad);
+	case V4L2_SUBDEV_FORMAT_ACTIVE:
+		return mode->analog_crop;
+	}
+
+	return NULL;
+}
+
+static int ov5678_get_selection(struct v4l2_subdev *subdev,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct ov5678 *sensor = to_ov5678(subdev);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		mutex_lock(&sensor->mutex);
+		sel->r = *__ov5678_get_pad_crop(sensor, state, sel->pad,
+						sel->which);
+		mutex_unlock(&sensor->mutex);
+		break;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = OV5678_NATIVE_WIDTH;
+		sel->r.height = OV5678_NATIVE_HEIGHT;
+		break;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+		sel->r = ov5678_analog_crop;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
