[Unit]
Description=Set up v4l2loopback virtual cameras for processed sensors
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/modprobe v4l2loopback devices=2 video_nr=42,43 card_label="Processed GC5035,Processed OV5678" exclusive_caps=1,1 max_buffers=2
ExecStop=/usr/sbin/modprobe -r v4l2loopback

[Install]
WantedBy=multi-user.target
