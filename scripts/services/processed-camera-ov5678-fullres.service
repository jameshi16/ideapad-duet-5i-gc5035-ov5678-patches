[Unit]
Description=Processed virtual camera pipeline (OV5678 full resolution)
After=processed-camera-loopback.service
Requires=processed-camera-loopback.service
Conflicts=processed-camera-gc5035.service processed-camera-ov5678.service processed-camera-gc5035-fullres.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/home/agent/ipu6-drivers
ExecStartPre=/usr/bin/bash -lc '/home/agent/ipu6-drivers/configure-camera-link.sh ov5678'
ExecStartPre=/usr/bin/bash -lc '/home/agent/ipu6-drivers/camera-controls.sh --sensor ov5678 --preset pipeline'
ExecStart=/usr/bin/python3 /home/agent/ipu6-drivers/camera_pipeline.py --sensor ov5678 --input /dev/video24 --loopback /dev/video43 --in-width 2592 --in-height 1944 --downscale 1 --out-width 2592 --out-height 1944 --out-fps 5 --capture-fps 5 --ir-clip 1.3
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
